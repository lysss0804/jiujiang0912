# =====================================================================
#  .env 配置文件 —— 使用说明
# ---------------------------------------------------------------------
#  第 1 步 · 复制一份，重命名为 .env
#       Windows PowerShell :  Copy-Item .env.example .env
#       Windows cmd        :  copy .env.example .env
#       macOS / Linux      :  cp .env.example .env
#
#  第 2 步 · 默认优先调用真实模型，失败时自动降级
#       请在下面 4 行填写经批准的模型网关和密钥；无密钥、超时或接口失败时，
#       系统会按确定性规则和本地向量生成可用报告：
#           python -m app.main analyze      # 单供应商分析
#           python -m app.main batch        # 批量分析
#           python -m app.main serve        # 启动 HTTP 服务
#
#  注意：.env 已被 .gitignore 忽略，不会被上传，请放心填写。
# =====================================================================


# ---------------------------------------------------------------------
#  基础运行参数（一般不用改）
# ---------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
#  大模型配置（请填写实际已批准的 OpenAI 兼容网关）
# ---------------------------------------------------------------------
# 取值：openai-compatible = 调用真实 OpenAI 兼容接口
LLM_PROVIDER=openai-compatible
# 模型名
LLM_MODEL=
# ← 真实模式的密钥，部署环境填写
LLM_API_KEY=
# ← 真实模式的网关地址
LLM_BASE_URL=

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
MAX_OUTPUT_CHARS=8000

# ---------------------------------------------------------------------
#  LLM 节点开关（仅在 enable_live_llm=true 时生效，一般不用改）
#  true  = 该节点用真实模型生成文案
#  模型不可用（无密钥/余额不足/超时）时自动降级为确定性模板并标记 FALLBACK，
#  报告始终能生成，不会因为模型报错而失败。
# ---------------------------------------------------------------------
LLM_TEXT_RISK_IDENTIFICATION=true
LLM_TEXT_ASSOCIATION=true
LLM_TEXT_EVIDENCE=true
LLM_CONSISTENCY_CHECK=true

# ---------------------------------------------------------------------
#  向量检索 embedding（可选，一般不用改）
#  想用真实向量化服务再填这四项；全部留空 → 自动复用上面的大模型配置；
#  若上面模型不可用 → 自动回退本地哈希向量，检索功能照常可用。
# ---------------------------------------------------------------------
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=256

# ---------------------------------------------------------------------
#  路径与检索参数（一般不用改）
# ---------------------------------------------------------------------
RAG_TOP_K=3
KNOWLEDGE_DIR=data/knowledge
VECTOR_INDEX_PATH=data/index/vector_index.json
SOURCE_DATA_DIR=data/source
REPORT_OUTPUT_DIR=artifacts/reports
REVIEW_OUTPUT_PATH=artifacts/reviews/review_feedback.jsonl

# 本地联调为 SQLite；生产环境执行 db/schema_v1_postgresql.sql 并使用 PostgreSQL。
DATABASE_URL=sqlite:///data/jiujiang_backend.db
UPLOAD_DIR=data/uploads

# ---------------------------------------------------------------------
#  API 服务（本地联调留空即可；上线前务必配置 API_KEY）
#  API_KEY 留空 = 不鉴权；配置后所有接口需携带请求头 X-API-Key
# ---------------------------------------------------------------------
API_KEY=
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INTEGRATION_MOCK_MODE=true
# 上线完成 SSO/JWT 网关注入 X-User-Id 后设为 true，开启真实 RBAC 校验。
RBAC_ENFORCED=true

# 官方授权数据源仅在数据库登记环境变量名，令牌永远不进入代码、请求体或数据库。
TIANYANCHA_API_TOKEN=

# ---------------------------------------------------------------------
#  版本标记（一般不用改）
# ---------------------------------------------------------------------
WORKFLOW_VERSION=0.2.0-draft
PROMPT_VERSION=0.2.0-draft
