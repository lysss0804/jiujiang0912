# =====================================================================
#  .env 配置文件 —— 使用说明
# ---------------------------------------------------------------------
#  第 1 步 · 复制一份，重命名为 .env
#       Windows PowerShell :  Copy-Item .env.example .env
#       Windows cmd        :  copy .env.example .env
#       macOS / Linux      :  cp .env.example .env
#
#  第 2 步 · 直接用（推荐先这样做）
#       不填任何密钥也能跑！
#       系统会自动使用 mock 模式 + 本地向量，全部功能均可离线演示：
#           python -m app.main analyze      # 单供应商分析
#           python -m app.main batch        # 批量分析
#           python -m app.main serve        # 启动 HTTP 服务
#
#  第 3 步 · 想调用真实大模型时，才需要改下面 4 行
#       把第 1 步复制出的 .env 里这 4 行改成（示例为项目实际跑通的通道）：
#           LLM_PROVIDER=openai-compatible
#           LLM_MODEL=GLM-4-FlashX-250414
#           LLM_API_KEY=<向项目负责人索取，不要写进代码/仓库>
#           LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#       然后在调用接口时传 "enable_live_llm": true 即走真实模型。
#
#  注意：.env 已被 .gitignore 忽略，不会被上传，请放心填写。
# =====================================================================


# ---------------------------------------------------------------------
#  基础运行参数（一般不用改）
# ---------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
#  大模型配置（不填也能跑，见文件顶部第 2 步）
# ---------------------------------------------------------------------
# 取值：mock = 离线假数据；openai-compatible = 调用真实 OpenAI 兼容接口
LLM_PROVIDER=mock
# 模型名（mock 模式下随意；真实模式填服务商提供的模型名）
LLM_MODEL=mock-model
# ← 真实模式的密钥，没有就留空
LLM_API_KEY=
# ← 真实模式的网关地址，没有就留空（例：https://open.bigmodel.cn/api/paas/v4）
LLM_BASE_URL=

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
MAX_OUTPUT_CHARS=8000

# ---------------------------------------------------------------------
#  LLM 节点开关（仅在 enable_live_llm=true 时生效，一般不用改）
#  true  = 该节点用真实模型生成文案
#  模型不可用（无密钥/余额不足/超时）时自动降级为确定性模板并标记 FALLBACK，
#  报告始终能生成，不会因为模型报错而失败。
# ---------------------------------------------------------------------
LLM_TEXT_RISK_IDENTIFICATION=true
LLM_TEXT_ASSOCIATION=true
LLM_TEXT_EVIDENCE=true
LLM_CONSISTENCY_CHECK=true

# ---------------------------------------------------------------------
#  向量检索 embedding（可选，一般不用改）
#  想用真实向量化服务再填这四项；全部留空 → 自动复用上面的大模型配置；
#  若上面也是 mock → 自动回退本地哈希向量，检索功能照常可用。
# ---------------------------------------------------------------------
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=256

# ---------------------------------------------------------------------
#  路径与检索参数（一般不用改）
# ---------------------------------------------------------------------
RAG_TOP_K=3
KNOWLEDGE_DIR=data/knowledge
VECTOR_INDEX_PATH=data/index/vector_index.json
SOURCE_DATA_DIR=data/source
REPORT_OUTPUT_DIR=artifacts/reports
REVIEW_OUTPUT_PATH=artifacts/reviews/review_feedback.jsonl

# ---------------------------------------------------------------------
#  API 服务（本地联调留空即可；上线前务必配置 API_KEY）
#  API_KEY 留空 = 不鉴权；配置后所有接口需携带请求头 X-API-Key
# ---------------------------------------------------------------------
API_KEY=
API_CORS_ORIGINS=

# ---------------------------------------------------------------------
#  版本标记（一般不用改）
# ---------------------------------------------------------------------
WORKFLOW_VERSION=0.2.0-draft
PROMPT_VERSION=0.2.0-draft
